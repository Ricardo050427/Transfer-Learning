#!/bin/bash
#SBATCH --nodes=1
#SBATCH --job-name=pokemon_tl
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:30:00
#SBATCH --account=curso04
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=salida_pokemon_%j.log
#SBATCH --error=error_pokemon_%j.log

echo "Inicio del trabajo SLURM ID: $SLURM_JOB_ID"
echo "Nodo asignado: $(hostname)"
echo "Fecha y hora: $(date)"

source activate pokemon_env

nvidia-smi
python pokemon_transfer_learning.py \
    --data_dir "./data/pokemon" \
    --batch_size 32 \
    --initial_epochs 10 \
    --fine_tune_epochs 10 \
    --lr 0.001 \
    --export_dir "modelo_web"

echo "Exportando archivo de ambiente Conda..."
conda env export -n pokemon_env > pokemon_env.yml

echo "Trabajo finalizado con éxito: $(date)"
